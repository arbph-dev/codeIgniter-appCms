/* =========================
   Structure générale
   ========================= */

QMainWindow,
QWidget {
    font-family: "Segoe UI", "Arial";
    font-size: 14px;
}

QWidget#centralWidget {
    background-color: @background;
    color: @text;
}

QFrame#header {
    min-height: 64px;
    max-height: 64px;
    border: none;
    border-bottom: 1px solid @border;
    background-color: @header;
}

QLabel#appTitle {
    font-size: 20px;
    font-weight: bold;
    color: @accent;
}

QLabel#appSubtitle {
    font-size: 12px;
    color: @mutedText;
}

/* =========================
   Barre latérale
   ========================= */

QFrame#sidebar {
    min-width: 220px;
    max-width: 220px;
    border: none;
    border-right: 1px solid @border;
    background-color: @sidebar;
}

QLabel#sidebarTitle {
    padding: 12px 16px;
    font-size: 12px;
    font-weight: bold;
    color: @mutedText;
}

QListWidget#sidebarList {
    border: none;
    outline: none;
    padding: 8px;
    background-color: transparent;
    color: @text;
}

QListWidget#sidebarList::item {
    min-height: 42px;
    margin: 3px 0;
    padding: 0 14px;
    border-radius: 7px;
}

QListWidget#sidebarList::item:hover {
    background-color: @hover;
}

QListWidget#sidebarList::item:selected {
    background-color: @selected;
    color: @selectedText;
    border-left: 4px solid @accent;
}

/* =========================
   Zone de contenu
   ========================= */

QFrame#contentPanel {
    border: none;
    background-color: @background;
}

QFrame#panelCard {
    border: 1px solid @border;
    border-radius: 10px;
    background-color: @card;
}

QLabel#panelTitle {
    font-size: 24px;
    font-weight: bold;
    color: @text;
}

QLabel#panelDescription {
    color: @mutedText;
}

/* =========================
   Boutons
   ========================= */

QPushButton {
    min-height: 36px;
    padding: 0 16px;
    border: 1px solid @border;
    border-radius: 6px;
    background-color: @button;
    color: @text;
}

QPushButton:hover {
    background-color: @hover;
    border-color: @accent;
}

QPushButton:pressed {
    background-color: @pressed;
}

QPushButton#primaryButton {
    border: none;
    background-color: @accent;
    color: @accentText;
    font-weight: bold;
}

QPushButton#primaryButton:hover {
    background-color: @accentHover;
}

/* =========================
   Onglet des contrôles
   ========================= */

QTabWidget#controlsTabs {
    border: none;
}

QTabWidget#controlsTabs::pane {
    border: 1px solid @border;
    border-radius: 8px;
    background-color: @card;
    top: -1px;
}

QTabBar::tab {
    min-width: 130px;
    min-height: 36px;
    padding: 0 16px;
    border: none;
    color: @mutedText;
    background-color: transparent;
}

QTabBar::tab:hover {
    color: @text;
    background-color: @hover;
}

QTabBar::tab:selected {
    color: @accent;
    border-bottom: 2px solid @accent;
}

/* =========================
   Contrôles divers
   ========================= */

QLineEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox {
    min-height: 34px;
    padding: 0 10px;
    border: 1px solid @border;
    border-radius: 6px;
    background-color: @input;
    color: @text;
}

QLineEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QDoubleSpinBox:focus {
    border: 1px solid @accent;
}

QCheckBox,
QRadioButton {
    spacing: 8px;
    color: @text;
}

QProgressBar {
    min-height: 12px;
    border: none;
    border-radius: 6px;
    background-color: @border;
    text-align: center;
}

QProgressBar::chunk {
    border-radius: 6px;
    background-color: @accent;
}

QStatusBar {
    background-color: @header;
    color: @mutedText;
}